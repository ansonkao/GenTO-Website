const KIND_COLOR: Record<string, string> = {
  "Jury Member": "var(--magenta)",
  Speaker: "var(--cyan)",
  Moderator: "var(--yellow)",
};
---
<section id="jury" class="section" style="border-bottom:1px solid var(--line);">
  <div class="container">
    <div class="jury-head">
      <div>
        <span class="eyebrow">The Conversation</span>
        <h2 style="margin-top:18px;font-family:var(--font-display);font-size:clamp(36px, 4.5vw, 56px);letter-spacing:-0.025em;font-weight:500;line-height:1;">
          Jury Members <span style="font-family:var(--font-serif);font-style:italic;font-weight:400;">& Speakers.</span>
        </h2>
      </div>
      <p style="max-width:420px;font-size:15px;line-height:1.6;color:var(--ink-dim);">
        Films are judged by filmmakers, producers, and artists working at the edge of AI and cinema. More to be announced shortly.
      </p>
    </div>

    <div class="jury-grid">
      {people.map((p, i) => (
        <article class="jury-card">
          <div class="jury-portrait">
            <img src={p.photo} alt={p.name} width="800" height="800" loading="lazy" decoding="async" />
            <div class="jury-portrait-idx">[ {String(i + 1).padStart(3, "0")} ]</div>
          </div>
          <div class="jury-card-body">
            <div style={`font-family:var(--font-mono);font-size:10px;letter-spacing:0.2em;text-transform:uppercase;color:${KIND_COLOR[p.kind]};margin-bottom:14px;`}>
              {p.kind}
            </div>
            <h3 style="font-family:var(--font-display);font-size:24px;letter-spacing:-0.015em;font-weight:500;line-height:1.1;">
              {p.name}
            </h3>
            <div class="jury-role">{p.role}</div>
            <p style="margin-top:16px;color:var(--ink-dim);font-size:14px;line-height:1.55;">{p.bio}</p>
            {p.note && (
              <div class="jury-laurel">
                <span style="font-family:var(--font-mono);font-size:10px;letter-spacing:0.2em;color:var(--yellow);">◆ LATEST WIN</span>
                <span style="font-size:13px;line-height:1.5;color:var(--ink);">{p.note}</span>
              </div>
            )}
          </div>
        </article>
      ))}
    </div>
  </div>
</section>
