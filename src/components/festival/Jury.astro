  },
  {
    name: "Robert Gaudette",
    kind: "Speaker",
    role: "Filmmaker · Former Photographer",
    photo: "/people/robert-gaudette.jpg",
    bio: "A Canadian filmmaker and former photographer whose work blends generative AI with deeply human storytelling.",
    note: "Reply AI Film Festival, Venice — A Face Only a Mother Could Love",
