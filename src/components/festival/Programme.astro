---
const blocks = [
  {
    day: "DAY 01 · SAT",
    date: "DEC 05",
    accent: "var(--magenta)",
    items: [
      { time: "11:30", title: "Doors open / registration", kind: "Welcome" },
      { time: "12:00", title: "Opening Reception — Coffee & Snacks", kind: "Reception" },
      { time: "12:30", title: "Welcome to GenTO — Opening remarks", kind: "Opening" },
      { time: "12:40", title: "Screening Block 1 — Films, Ads & Music Videos", kind: "Screening" },
      { time: "13:30", title: "Panel 1 — AI in Arts & Culture", kind: "Panel" },
      { time: "14:15", title: "Break", kind: "Break" },
      { time: "14:30", title: "Screening Block 2 — Films, Ads & Music Videos", kind: "Screening" },
      { time: "15:20", title: "Panel 2 — AI in VFX", kind: "Panel" },
      { time: "16:05", title: "Coffee / Networking Break", kind: "Break" },
      { time: "16:20", title: "Screening Block 3 — Films, Ads & Music Videos", kind: "Screening" },
      { time: "17:10", title: "Panel 3 — AI for Storytelling", kind: "Panel" },
      { time: "17:55", title: "Dinner Break", kind: "Break" },
      { time: "18:55", title: "GenTO Final Screening Block", kind: "Screening" },
      { time: "19:45", title: "Intermission / Awards Setup", kind: "Break" },
      { time: "20:00", title: "GenTO Awards Ceremony", kind: "Awards" },
      { time: "20:50", title: "Closing Remarks / Group Photo", kind: "Closing" },
      { time: "21:00", title: "Afterparty at Duke of York", kind: "Social" },
    ],
  }
];
---
<section class="section" style="background:var(--bg-2);border-bottom:1px solid var(--line);">
  <div class="container">
    <span class="eyebrow">Programme</span>
    <h2 style="margin-top:18px;font-family:var(--font-display);font-size:clamp(40px, 5vw, 72px);letter-spacing:-0.025em;font-weight:500;line-height:1;margin-bottom:28px;">
      One day. <span style="font-family:var(--font-serif);font-style:italic;font-weight:400;">One room.</span>
    </h2>
    <p style="margin-bottom:64px;font-size:18px;line-height:1.65;color:var(--ink-dim);max-width:640px;text-wrap:pretty;">
      The <strong style="color:var(--magenta);font-weight:600;">full schedule is subject to change</strong> as we confirm speakers, films, and partners. We will announce the final programme in the fall, ahead of the festival weekend.
    </p>
    <div class="programme-grid">
      {blocks.map((b) => (
        <div style="border:1px solid var(--line);background:var(--bg);">
          <div style="padding:24px 28px;border-bottom:1px solid var(--line);display:flex;justify-content:space-between;align-items:baseline;">
            <span style={`font-family:var(--font-mono);font-size:11px;letter-spacing:0.22em;color:${b.accent};`}>
              {b.day}
            </span>
            <span style="font-family:var(--font-display);font-size:32px;letter-spacing:-0.015em;">{b.date}</span>
          </div>
          <div>
            {b.items.map((it, j) => (
              <div
                class="programme-row"
                style={j < b.items.length - 1 ? "border-bottom:1px solid var(--line);" : ""}
              >
                <span style="font-family:var(--font-mono);font-size:13px;color:var(--ink-dim);">{it.time}</span>
                <span style="font-size:15px;">{it.title}</span>
                <span style="font-family:var(--font-mono);font-size:10px;letter-spacing:0.16em;text-transform:uppercase;color:var(--yellow);justify-self:end;">
                  [ {it.kind} ]
                </span>
              </div>
            ))}
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
