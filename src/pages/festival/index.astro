---
import BaseLayout from "../../layouts/BaseLayout.astro";
import SiteHeader from "../../components/SiteHeader.astro";
import SiteFooter from "../../components/SiteFooter.astro";
import SubHeader from "../../components/SubHeader.astro";
import CountdownBanner from "../../components/festival/CountdownBanner.astro";
import MagnificLogo from "../../components/MagnificLogo.astro";
import FestivalHero from "../../components/festival/FestivalHero.astro";
import Programme from "../../components/festival/Programme.astro";
import Ethos from "../../components/festival/Ethos.astro";
import Awards from "../../components/festival/Awards.astro";
import Jury from "../../components/festival/Jury.astro";
import Venue from "../../components/festival/Venue.astro";
import Submit from "../../components/festival/Submit.astro";
import "../../styles/global.css";

const meta = [
  { k: "Dates", v: "DEC 5, 2026", accent: "var(--magenta)" },
  { k: "Venue", v: "Innis Town Hall" },
  { k: "City", v: "Toronto, ON" },
  { k: "Edition", v: "001 · Inaugural", accent: "var(--ink)" },
];
---
<BaseLayout title="GenTO Film Festival — Cinema, Evolved">
  <SiteHeader active="festival" />
  <SubHeader
    title="Toronto AI Film Festival"
    lede="A full-day celebration of AI-enhanced storytelling at Innis Town Hall Theatre, University of Toronto. Short films, panels, demos, and awards for bold new cinema — local and international."
    meta={meta}
    accent="var(--magenta)"
    bgSeed={0}
    bgImage="/innis-empty.png"
    hasSlotBottom
    fullHeight
    ledeHideMobile
  >
    <Fragment slot="eyebrow"><MagnificLogo /><span>presents</span></Fragment>
    <CountdownBanner slot="bottom" />
  </SubHeader>
  <FestivalHero />
  <Jury />
  <Programme />
  <Ethos />
  <Awards />
  <Venue />
  <Submit />
  <SiteFooter />
</BaseLayout>
